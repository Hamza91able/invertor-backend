# --- Server ---
PORT=3000
NODE_ENV=development

# --- Solarman stick logger (LAN) ---
# Serial printed on the stick. LOGGER_HOST is optional: leave it empty to
# discover the logger on the local network (it is also rediscovered if unreachable).
LOGGER_HOST=
LOGGER_SERIAL=0000000000
LOGGER_PORT=8899
MODBUS_SLAVE_ID=1

# --- Grid monitor ---
GRID_POLL_INTERVAL_MS=10000

# --- Pushover push notifications (optional; logs only when unset) ---
# App token from pushover.net/apps/build, user key from the pushover.net dashboard.
# Never commit real values.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
