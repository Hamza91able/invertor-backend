# --- Server ---
PORT=3000
NODE_ENV=development

# --- Solarman stick logger (LAN) ---
# IP of the logger on your WiFi and the serial printed on the stick.
LOGGER_HOST=192.168.x.x
LOGGER_SERIAL=0000000000
LOGGER_PORT=8899
MODBUS_SLAVE_ID=1

# --- Grid monitor ---
GRID_POLL_INTERVAL_MS=10000

# --- Pushover push notifications (optional; logs only when unset) ---
# App token from pushover.net/apps/build, user key from the pushover.net dashboard.
# Never commit real values.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
